# Copy to .env and replace all values before deployment.
POSTGRES_PASSWORD=replace-with-random-postgres-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-reader-password
MQTT_PASSWORD=replace-with-random-broker-password
API_TOKEN=replace-with-random-api-token
MYSQL_USERNAME=agent_reader
MYSQL_DATABASE=production_db
MYSQL_HOST=mysql
MYSQL_PORT=3306
